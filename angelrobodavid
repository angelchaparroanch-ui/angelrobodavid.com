const P={v:0,t:0,on:false,i:-1,tm:null};
const vTot=()=>VD[P.v].sc.reduce((a,s)=>a+s.d,0);
function vIdx(){let a=0;const s=VD[P.v].sc;for(let i=0;i<s.length;i++){a+=s[i].d;if(P.t<a)return i}return s.length-1}
const vStart=i=>VD[P.v].sc.slice(0,i).reduce((a,s)=>a+s.d,0);
/* --- voz de Robi: robusta, con detección real de soporte y activación por gesto --- */
const VOX={supported:'speechSynthesis' in window && typeof SpeechSynthesisUtterance!=='undefined',on:false,list:[]};
function voxLoad(){if(VOX.supported){try{VOX.list=speechSynthesis.getVoices()||[]}catch(e){VOX.list=[]}}}
if(VOX.supported){voxLoad();try{speechSynthesis.onvoiceschanged=voxLoad}catch(e){}}
function voxPick(){return VOX.list.find(v=>/^es/i.test(v.lang))||VOX.list.find(v=>/es/i.test(v.lang))||null}
function voxPaint(){
  const b=$('#vVoiceBtn'),s=$('#vVoiceState');
  if(!VOX.supported){b.disabled=true;b.textContent='🔇 Este navegador no tiene voz';s.textContent='No pasa nada: los subtítulos grandes siempre funcionan.';return}
  b.setAttribute('aria-pressed',String(VOX.on));b.textContent=VOX.on?'🔊 Voz activada':'🔈 Activar la voz de Robi';
  s.textContent=VOX.on?'Robi va a leer cada escena en voz alta.':'';
}
$('#vVoiceBtn').addEventListener('click',()=>{
  if(!VOX.supported)return;
  VOX.on=!VOX.on;
  try{speechSynthesis.cancel()}catch(e){}
  if(VOX.on){voxLoad();try{const u=new SpeechSynthesisUtterance('');u.volume=0;speechSynthesis.speak(u)}catch(e){}P.i=-1;vShow()}
  voxPaint();
});
voxPaint();
function speak(txt){
  if(!P.on||!VOX.on||!VOX.supported)return;
  try{
    speechSynthesis.cancel();
    const u=new SpeechSynthesisUtterance(txt);u.lang='es-419';u.rate=.95;u.pitch=1.2;
    const v=voxPick();if(v)u.voice=v;
    speechSynthesis.speak(u);
  }catch(e){}
}
function vShow(){
  const i=vIdx();
  if(i!==P.i){P.i=i;const s=VD[P.v].sc[i];$('#stage').innerHTML='<div class="sc">'+s.h+'</div>';$('#vcap').textContent=s.c;$$('#chap button').forEach((b,k)=>b.classList.toggle('on',k===i));speak(s.c)}
  $('#vBar').style.width=(P.t/vTot()*100)+'%';
