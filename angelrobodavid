  }else{
    el.classList.add('no'); setTimeout(()=>el.classList.remove('no'),400);
    $('#safeMsg').className='msg bad';
    $('#safeMsg').textContent='⚠️ Piensa bien: ¿es seguro o peligroso para ti o los componentes?';
