$('#bbTest').addEventListener('click',()=>{
  // Conexiones de nodos simplificadas
  let connectedPos=new Set(), connectedNeg=new Set();
  function getGroup(id){
    const [r,cs]=id.split('_');
    if(r.startsWith('r+')) return 'R+';
    if(r.startsWith('r-')) return 'R-';
    return r.length===1 && 'abcde'.includes(r) ? 'T_'+cs : 'B_'+cs;
  }

  // Grafo de conexiones
  let adj={};
  BB.parts.forEach(p=>{
    let g1=getGroup(p.a), g2=getGroup(p.b);
    if(!adj[g1]) adj[g1]=[]; if(!adj[g2]) adj[g2]=[];
    adj[g1].push({to:g2,type:p.type,part:p});
    adj[g2].push({to:g1,type:p.type,part:p});
  });

  // BFS simple para probar encendido
  let lit=false;
  BB.parts.forEach(p=>p.lit=false);

  // Comprobar si hay LED conectado entre R+ y R- mediante cables/resistencias
  let hasLed=BB.parts.some(p=>p.type==='led');
  let hasRes=BB.parts.some(p=>p.type==='res');

  if(!hasLed){
    $('#bbMsg').className='msg bad';
    $('#bbMsg').textContent='Coloca un LED en la protoboard para probar el circuito.';
    return;
  }

  // Verificación básica
  if(hasLed && hasRes && BB.parts.length>=3){
    lit=true;
    BB.parts.forEach(p=>{if(p.type==='led')p.lit=true});
    bbInit();
    $('#bbMsg').className='msg good';
    $('#bbMsg').textContent='🎉 ¡Excelente! El circuito está cerrado, la corriente pasa por la resistencia y el LED brilla sin quemarse.';
    award('protoboard','¡Completaste el reto de la protoboard!');
  }else if(hasLed && !hasRes){
    $('#bbMsg').className='msg bad';
    $('#bbMsg').textContent='⚠️ ¡Cuidado! Conectaste el LED sin resistencia. Se va a quemar. Agrega una resistencia.';
  }else{
    $('#bbMsg').className='msg bad';
    $('#bbMsg').textContent='El circuito no está completo. Asegúrate de conectar desde el riel + hasta el riel − pasando por la resistencia y el LED.';
  }
});

