let arOnMs=1000, arOffMs=1000, arTimer=null;
function arRun(){
  clearTimeout(arTimer);
  const glow=$('#arGlow'), led=$('#arLed');
  function step(state){
    if(state){
      glow.style.opacity='1'; led.setAttribute('fill','#ff3333');
      arTimer=setTimeout(()=>step(false), arOnMs);
    }else{
      glow.style.opacity='0'; led.setAttribute('fill','#8a3b3b');
      arTimer=setTimeout(()=>step(true), arOffMs);
    }
  }
  step(true);
}

$('#arOn').addEventListener('input',e=>{
  arOnMs=+e.target.value; $('#arOnV').textContent=arOnMs;
  $('#arRead').textContent=`Encendido: ${arOnMs} ms | Apagado: ${arOffMs} ms`;
  arRun();
});
$('#arOff').addEventListener('input',e=>{
  arOffMs=+e.target.value; $('#arOffV').textContent=arOffMs;
  $('#arRead').textContent=`Encendido: ${arOnMs} ms | Apagado: ${arOffMs} ms`;
  arRun();
});
$$('[data-p]').forEach(b=>b.addEventListener('click',()=>{
  const [on,off]=b.dataset.p.split(',').map(Number);
