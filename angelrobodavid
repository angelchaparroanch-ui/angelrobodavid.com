      if(p.lit) h+=`<circle cx="${mx}" cy="${my}" r="26" fill="url(#cGlow)" opacity="0.8" class="glow"/>`;
    }
  });

  // Agujeros
  for(let c=0;c<20;c++){
    const x=45+c*28;
