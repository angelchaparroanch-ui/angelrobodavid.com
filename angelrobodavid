    }else{
      const d=mk('div','blk '+b.type);
      d.innerHTML=`<span>${bLabel(b.type)}</span><button class="x" data-del="${i}">✕</button>`;
      box.append(d);
    }
  });
  $('#tgt').textContent=repActive!==null?'👉 Agregando bloques DENTRO del Repetir':'👉 Agregando bloques al programa principal';
}

function bLabel(t){
  if(t==='f') return '⬆ Avanzar';
  if(t==='l') return '↺ Girar izquierda';
  if(t==='r') return '↻ Girar derecha';
}

$('.pal').addEventListener('click',e=>{
  const b=e.target.closest('button'); if(!b) return;
  const type=b.dataset.b;
  if(type==='rep'){
    gProg.push({type:'rep',n:2,sub:[]});
    repActive=gProg.length-1;
  }else{
    if(repActive!==null && gProg[repActive] && gProg[repActive].type==='rep'){
      gProg[repActive].sub.push(type);
    }else{
      gProg.push({type});
    }
  }
  renderProg();
});

$('#prog').addEventListener('click',e=>{
  if(e.target.dataset.del!==undefined){
    const i=+e.target.dataset.del;
    gProg.splice(i,1); if(repActive===i) repActive=null;
    renderProg();
  }else if(e.target.dataset.delsub!==undefined){
    const [i,j]=e.target.dataset.delsub.split('_').map(Number);
    gProg[i].sub.splice(j,1);
    renderProg();
  }
});

$('#prog').addEventListener('change',e=>{
  if(e.target.classList.contains('mini')){
    const i=+e.target.dataset.i;
    gProg[i].n=clamp(+e.target.value,2,9);
  }
});

$('#gClear').addEventListener('click',()=>{gProg=[];repActive=null;renderProg()});
$('#gReset').addEventListener('click',()=>{
  const lv=LEVELS[curLv]; botX=lv.x; botY=lv.y; botDir=lv.dir;
  renderGrid(); $('#gMsg').className='msg'; $('#gMsg').textContent='Robi volvió al inicio.';
});

$('#gRun').addEventListener('click',async ()=>{
  if(gBusy) return; gBusy=true;
  const lv=LEVELS[curLv]; botX=lv.x; botY=lv.y; botDir=lv.dir; renderGrid();

  // Aplanar instrucciones
  let queue=[];
  gProg.forEach(b=>{
    if(b.type==='rep'){
      for(let k=0;k<b.n;k++) b.sub.forEach(st=>queue.push(st));
    }else queue.push(b.type);
  });

  if(!queue.length){
    $('#gMsg').className='msg bad'; $('#gMsg').textContent='Agrega bloques antes de ejecutar.';
    gBusy=false; return;
  }

  const map=lv.map, rows=map.length, cols=map[0].length;
  let crashed=false;

  for(let cmd of queue){
    if(cmd==='l') botDir=(botDir+3)%4;
    else if(cmd==='r') botDir=(botDir+1)%4;
    else if(cmd==='f'){
      let nx=botX, ny=botY;
      if(botDir===0) ny--;
      else if(botDir===1) nx++;
      else if(botDir===2) ny++;
      else if(botDir===3) nx--;

      if(nx<0||nx>=cols||ny<0||ny>=rows||map[ny][nx]===1){
        crashed=true; break;
      }
      botX=nx; botY=ny;
    }
    renderGrid();
    await sleep(400);
  }

  if(crashed){
    $('#gMsg').className='msg bad';
    $('#gMsg').textContent='💥 ¡Ouch! Robi se chocó contra un obstáculo o se salió del mapa. Revisa tu programa y depúralo.';
  }else if(map[botY][botX]===2){
    $('#gMsg').className='msg good';
    $('#gMsg').textContent='🎉 ¡Misión cumplida! Robi llegó a la estrella ⭐.';
    if(curLv<LEVELS.length-1) $('#gNext').hidden=false;
    award('bloques','¡Completaste el reto de programación con bloques!');
  }else{
    $('#gMsg').className='msg';
    $('#gMsg').textContent='Robi terminó su recorrido pero no llegó a la estrella. ¡Agrega más bloques!';
  }
  gBusy=false;
});

$('#gNext').addEventListener('click',()=>{if(curLv<LEVELS.length-1) loadLv(curLv+1)});
loadLv(0);

