const C={sw:true,bats:2,res:true,burned:false};
function cDraw(){
  const svg=$('#cSvg');
  const batX=130,batY=190,resX=210,resY=60,ledX=360,ledY=125,swX=60,swY=125;
  let batH='';
  for(let i=0;i<C.bats;i++){
    const x=batX-24+(i-(C.bats-1)/2)*28;
    batH+=`<rect x="${x}" y="${batY-18}" width="20" height="36" rx="4" fill="#333" stroke="#fff" stroke-width="1.5"/><rect x="${x+5}" y="${batY-24}" width="10" height="6" rx="2" fill="#aaa"/><text x="${x+10}" y="${batY+5}" fill="#fff" font-size="10" text-anchor="middle" font-weight="bold">${1.5}V</text>`;
  }
  $('#cBat').innerHTML=batH;
  let resH='';
  if(C.res){
    resH=`<rect x="${resX-30}" y="${resY-12}" width="60" height="24" rx="8" fill="#e6c79c" stroke="#8a6d3b" stroke-width="2"/><line x1="${resX-18}" y1="${resY-12}" x2="${resX-18}" y2="${resY+12}" stroke="#e5383b" stroke-width="4"/><line x1="${resX-6}" y1="${resY-12}" x2="${resX-6}" y2="${resY+12}" stroke="#e5383b" stroke-width="4"/><line x1="${resX+6}" y1="${resY-12}" x2="${resX+6}" y2="${resY+12}" stroke="#d9721c" stroke-width="4"/><text x="${resX}" y="${resY+30}" fill="var(--ink)" font-size="12" text-anchor="middle" font-weight="bold">220 Ω</text>`;
  }else{
    resH=`<line x1="${resX-30}" y1="${resY}" x2="${resX+30}" y2="${resY}" stroke="var(--ink)" stroke-width="5"/>`;
  }
  $('#cRes').innerHTML=resH;
  const v=C.bats*1.5, r=C.res?220:10, iMA=v/r*1000;
  let ledFill='#8a3b3b', glowOp=0;
  if(C.sw&&!C.burned){
    if(!C.res&&C.bats>1){C.burned=true}
    else{
      glowOp=Math.min(1,iMA/20);
      ledFill=iMA>30?'#ff2222':'#ff5d5d';
    }
  }
  let ledH=`<circle cx="${ledX}" cy="${ledY}" r="40" fill="url(#cGlow)" opacity="${glowOp}"/><circle cx="${ledX}" cy="${ledY}" r="20" fill="${C.burned?'#333':ledFill}" stroke="#12263a" stroke-width="3"/><text x="${ledX}" y="${ledY+38}" fill="var(--ink)" font-size="12" text-anchor="middle" font-weight="bold">${C.burned?'LED QUEMADO💥':'LED'}</text>`;
  $('#cLed').innerHTML=ledH;
  let swH=`<circle cx="${swX}" cy="${swY-20}" r="5" fill="#12263a"/><circle cx="${swX}" cy="${swY+20}" r="5" fill="#12263a"/>`;
  if(C.sw){
    swH+=`<line x1="${swX}" y1="${swY-20}" x2="${swX}" y2="${swY+20}" stroke="#e5383b" stroke-width="5"/>`;
  }else{
    swH+=`<line x1="${swX}" y1="${swY-20}" x2="${swX-20}" y2="${swY+15}" stroke="#e5383b" stroke-width="5"/>`;
  }
  $('#cSw').innerHTML=swH;
  const dots=$('#cDots');
  if(C.sw&&!C.burned){
    let dH='';
    for(let k=0;k<8;k++){
      dH+=`<circle r="4" fill="#ffc933"><animateMotion dur="${Math.max(0.4, 300/iMA)}s" begin="${k*0.2}s" repeatCount="indefinite" path="M60 60 H360 V190 H60 Z"/></circle>`;
    }
    dots.innerHTML=dH;
  }else{dots.innerHTML=''}

  $('#cSwBtn').textContent='Interruptor: '+(C.sw?'cerrado':'abierto');
  $('#cSwBtn').setAttribute('aria-pressed',String(C.sw));
  $$('[data-n]').forEach(b=>b.setAttribute('aria-pressed',String(+b.dataset.n===C.bats)));
  $('#cResBtn').textContent=C.res?'Quitar resistencia':'Poner resistencia';
  $('#cFix').hidden=!C.burned;

  const read=$('#cRead');
  read.textContent=`Voltaje: ${es(v)} V | Resistencia: ${r} Ω | Corriente: ${es(iMA.toFixed(1))} mA`;
  const msg=$('#cMsg');
  if(C.burned){
    msg.className='msg bad';
    msg.textContent='💥 ¡El LED se quemó! Pasó demasiada corriente ('+es(iMA.toFixed(1))+' mA) porque no había resistencia para protegerlo. Toca «🔧 Cambiar LED».';
  }else if(!C.sw){
    msg.className='msg';
    msg.textContent='El interruptor está abierto: el camino de la electricidad está cortado.';
  }else if(C.bats===1&&C.res){
    msg.className='msg';
    msg.textContent='1,5 V da poquita presión: el LED brilla suavemente.';
  }else{
    msg.className='msg good';
    msg.textContent='¡Circuito perfecto! El LED brilla de forma segura gracias a la resistencia.';
    award('circuito','¡Dominaste el laboratorio de electricidad!');
  }
}
$('#cSwBtn').addEventListener('click',()=>{C.sw=!C.sw;cDraw()});
$$('[data-n]').forEach(b=>b.addEventListener('click',()=>{C.bats=+b.dataset.n;cDraw()}));
$('#cResBtn').addEventListener('click',()=>{C.res=!C.res;cDraw()});
$('#cFix').addEventListener('click',()=>{C.burned=false;C.res=true;cDraw()});
cDraw();

