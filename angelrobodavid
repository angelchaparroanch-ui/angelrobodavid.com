    h+=`<circle cx="${x}" cy="28" r="4.5" fill="#12263a"/><rect class="hit" data-id="r+1_${c}" x="${x-10}" y="18" width="20" height="20"/>`;
    h+=`<circle cx="${x}" cy="58" r="4.5" fill="#12263a"/><rect class="hit" data-id="r-1_${c}" x="${x-10}" y="48" width="20" height="20"/>`;
