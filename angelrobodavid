 {t:'Tocar componentes con las manos mojadas.', ok:false},
 {t:'Desconectar la energía antes de cambiar cables.', ok:true},
 {t:'Usar una resistencia siempre para proteger un LED.', ok:true},
 {t:'Dejar cables pelados tocándose entre sí sin querer (cortocircuito).', ok:false}
];
let safeOk=0;
const safeBox=$('#safe');
SAFE_CASES.forEach((c,i)=>{
  const d=mk('div','sortc');
  d.innerHTML=`<b>${c.t}</b><div class="opts"><button class="okb">Seguro ✅</button><button class="nob">Peligro ⚠️</button></div>`;
  $('.okb',d).onclick=()=>checkSafe(i,true,d);$('.nob',d).onclick=()=>checkSafe(i,false,d);
