    ['f','g','h','i','j'].forEach((r,ri)=>{
      const y=200+ri*16;
      h+=`<circle cx="${x}" cy="${y}" r="4.5" fill="#12263a"/><rect class="hit" data-id="${r}_${c}" x="${x-10}" y="${y-7}" width="20" height="14"/>`;
    });
    // Rieles bot
    h+=`<circle cx="${x}" cy="292" r="4.5" fill="#12263a"/><rect class="hit" data-id="r+2_${c}" x="${x-10}" y="282" width="20" height="20"/>`;
    h+=`<circle cx="${x}" cy="322" r="4.5" fill="#12263a"/><rect class="hit" data-id="r-2_${c}" x="${x-10}" y="312" width="20" height="20"/>`;
  }

  if(BB.sel){
    const p=bbPos(BB.sel);
    h+=`<circle cx="${p.x}" cy="${p.y}" r="10" fill="none" stroke="#ffc933" stroke-width="3" class="glow"/>`;
