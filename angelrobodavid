];

let qAns={};
function renderQuiz(){
  const box=$('#qBox'); box.innerHTML='';
  QUIZ.forEach((item,i)=>{
    const d=mk('div','card',`<p><b>${i+1}. ${item.q}</b></p>`);
    item.o.forEach((opt,j)=>{
      const btn=mk('button','qopt',opt);
      if(qAns[i]!==undefined){
        if(j===item.a) btn.classList.add('right');
        else if(j===qAns[i]) btn.classList.add('wrong');
        btn.disabled=true;
      }
      btn.onclick=()=>{
        qAns[i]=j; renderQuiz(); checkQuizScore();
      };
      d.append(btn);
    });
    box.append(d);
  });
}

function checkQuizScore(){
  const answered=Object.keys(qAns).length;
  if(answered===QUIZ.length){
    let score=0;
    QUIZ.forEach((q,i)=>{if(qAns[i]===q.a) score++});
    if(score>=7){
      $('#diploma').hidden=false;
      $('#dipDate').textContent='Fecha: '+new Date().toLocaleDateString('es-ES');
      award('quiz','¡Aprobaste el Reto Final y obtuviste tu diploma!');
    }
  }
}
renderQuiz();

