function checkSafe(idx,ans,el){
  if(ans===SAFE_CASES[idx].ok){
    el.classList.add('ok'); $('.opts',el).innerHTML='<span class="sub">✅ ¡Correcto!</span>';
    safeOk++;
    if(safeOk===SAFE_CASES.length){
      $('#safeMsg').className='msg good';
      $('#safeMsg').textContent='🎉 ¡Demostraste que sabes trabajar con seguridad!';
      award('casa','¡Completaste el reto de seguridad!');
