function bbPos(id){
  const [r,cs]=id.split('_'), c=+cs, x=45+c*28;
  if(r==='r+1') return {x,y:28};
  if(r==='r-1') return {x,y:58};
  if(r==='r+2') return {x,y:292};
  if(r==='r-2') return {x,y:322};
  const riTop=['a','b','c','d','e'].indexOf(r);
  if(riTop!==-1) return {x,y:76+riTop*16};
  const riBot=['f','g','h','i','j'].indexOf(r);
  return {x,y:200+riBot*16};
}

