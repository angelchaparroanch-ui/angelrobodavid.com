      h+=`<line x1="${p1.x}" y1="${p1.y}" x2="${p2.x}" y2="${p2.y}" stroke="${p.col||'#2f6fed'}" stroke-width="5" stroke-linecap="round"/>`;
    }else if(p.type==='res'){
      const mx=(p1.x+p2.x)/2, my=(p1.y+p2.y)/2;
      h+=`<line x1="${p1.x}" y1="${p1.y}" x2="${p2.x}" y2="${p2.y}" stroke="#8a8f98" stroke-width="3"/>`;
      h+=`<rect x="${mx-16}" y="${my-8}" width="32" height="16" rx="6" fill="#e6c79c" stroke="#8a6d3b" stroke-width="2"/>`;
      h+=`<line x1="${mx-6}" y1="${my-8}" x2="${mx-6}" y2="${my+8}" stroke="#e5383b" stroke-width="3"/>`;
      h+=`<line x1="${mx}" y1="${my-8}" x2="${mx}" y2="${my+8}" stroke="#e5383b" stroke-width="3"/>`;
